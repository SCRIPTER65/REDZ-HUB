local RS = game:GetService("ReplicatedStorage")  
  
-- ConfiguraciÃ³n  
local COOLDOWN = 1.0  
local OFFSET = CFrame.new(0, 0, 3)  -- detrÃ¡s del enemigo  
  
-- Remote correcto (CommF_)  
local remote = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("CommF_")  
if not remote then  
    print("Remote no encontrado")  
    return  
end  
  
-- Equipar fruta Portal (por si acaso)  
local function equipFruit()  
    pcall(function() remote:InvokeServer("EquipFruit", "Portal") end)  
end  
  
-- Obtener jugador mÃ¡s cercano  
local function getNearest()  
    local nearest, minDist = nil, math.huge  
    local myChar = lp.Character  
    if not myChar then return nil end  
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")  
    if not myRoot then return nil end  
    for _, plr in pairs(Players:GetPlayers()) do  
        if plr ~= lp and plr.Character then  
            local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")  
            if targetRoot then  
                local dist = (targetRoot.Position - myRoot.Position).Magnitude  
                if dist < minDist then  
                    minDist = dist  
                    nearest = plr  
                end  
            end  
        end  
    end  
    return nearest  
end  
  
-- AcciÃ³n principal: TP + X  
local selectedTarget = nil  
local lastAttack = -999  
local listOpen = false  
  
local function doAttack()  
    if tick() - lastAttack < COOLDOWN then return end  
    local target = selectedTarget or getNearest()  
    if not target then return end  
    local targetChar = target.Character  
    if not targetChar then return end  
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")  
    if not targetRoot then return end  
    local myChar = lp.Character  
    if not myChar then return end  
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")  
    if not myRoot then return end  
  
    -- Teletransporte  
    myRoot.CFrame = targetRoot.CFrame * OFFSET  
    lastAttack = tick()  
    wait(0.05)  
  
    -- Asegurar fruta Portal y lanzar X  
    equipFruit()  
    wait(0.02)  
    VIM:SendKeyEvent(true, Enum.KeyCode.X, false, game)  
    wait(0.02)  
    VIM:SendKeyEvent(false, Enum.KeyCode.X, false, game)  
    wait(0.02)  
    VIM:SendKeyEvent(true, Enum.KeyCode.X, false, game)  
    wait(0.02)  
    VIM:SendKeyEvent(false, Enum.KeyCode.X, false, game)  
end  
  
