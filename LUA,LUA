    end)  
    Instance.new("UICorner", autoBtn).CornerRadius = UDim.new(0,4)  
    for _, plr in pairs(Players:GetPlayers()) do  
        if plr ~= lp then  
            local btn = Instance.new("TextButton")  
            btn.Size = UDim2.new(1,-8,0,32)  
            btn.Position = UDim2.new(0,4,0,0)  
            btn.BackgroundColor3 = Color3.fromRGB(35,35,35)  
            btn.Text = plr.Name  
            btn.TextColor3 = Color3.new(1,1,1)  
            btn.TextSize = 12  
            btn.Font = Enum.Font.Gotham  
            btn.Parent = scroll  
            btn.MouseButton1Click:Connect(function()  
                selectedTarget = plr  
                listFrame.Visible = false  
                listOpen = false  
                targetLabel.Text = plr.Name  
            end)  
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0,4)  
        end  
    end  
    wait()  
    scroll.CanvasSize = UDim2.new(0,0,0, layout.AbsoluteContentSize.Y + 8)  
end  
  
-- Arrastre del botÃ³n  
local dragging = false  
local dragStart = nil  
local startPos = nil  
  
mainBtn.InputBegan:Connect(function(input)  
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then  
        dragging = true  
        dragStart = input.Position  
        startPos = mainBtn.Position  
    end  
end)  
  
UIS.InputChanged:Connect(function(input)  
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then  
        local delta = input.Position - dragStart  
        mainBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)  
    end  
end)  
  
UIS.InputEnded:Connect(function(input)  
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then  
        dragging = false  
    end  
end)  
  
mainBtn.MouseButton1Click:Connect(function()  
    if listOpen then  
        listFrame.Visible = false  
        listOpen = false  
    end  
    doAttack()  
end)  
  
listBtn.MouseButton1Click:Connect(function()  
    if listOpen then  
        listFrame.Visible = false  
        listOpen = false  
    else  
        buildPlayerList()  
        listFrame.Visible = true  
        listOpen = true  
    end  
end)  
  
closeList.MouseButton1Click:Connect(function()  
    listFrame.Visible = false  
    listOpen = false  
end)  
  
RunService.RenderStepped:Connect(function()  
    local remain = COOLDOWN - (tick() - lastAttack)  
    if remain > 0 then  
        mainBtn.BackgroundTransparency = 0.6  
        mainBtn.Text = string.format("%.1f", remain)  
        stroke.Transparency = 0.7  
    else  
        mainBtn.BackgroundTransparency = 0.2  
        mainBtn.Text = "SACRED\nSORU"  
        stroke.Transparency = 0.3  
    end  
    if not selectedTarget then  
        local near = getNearest()  
        targetLabel.Text = near and near.Name or "Nadie"  
    else  
        if not selectedTarget.Character then  
            selectedTarget = nil  
            targetLabel.Text = "Auto"  
        else  
            targetLabel.Text = selectedTarget.Name  
        end  
    end  
end)  
  
