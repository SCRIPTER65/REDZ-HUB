-- Function for the Loading Animation (0% to 100%)
local function startLoading()
	for i = 0, 100, 2 do -- Increases by 2% each step
		loadingText.Text = "Loading... " .. i .. "%"
		task.wait(0.05) -- Adjust this to change loading speed
	end
	
	loadingText.Text = "Loading Complete!"
	task.wait(0.5)
end

-- Function to Execute the Correct Script Based on Username
