-- Function to Fade and Remove the Loading Screen
local function hideLoadingScreen()
	local fadeInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	-- Animate fading out
	local fadeBg = TweenService:Create(background, fadeInfo, {BackgroundTransparency = 1})
	local fadeNexus = TweenService:Create(nexusText, fadeInfo, {TextTransparency = 1})
	local fadeLoading = TweenService:Create(loadingText, fadeInfo, {TextTransparency = 1})
	
	fadeBg:Play()
	fadeNexus:Play()
	fadeLoading:Play()
	
	fadeBg.Completed:Wait() -- Wait for the transition to finish
	nexusGui:Destroy() -- Delete the GUI from the game
end

---------------------------------------
-- Main Execution Sequence
---------------------------------------

task.wait(0.1) -- Brief pause before starting

startLoading()        -- 1. Run the progress bar
executeCorrectScript() -- 2. Run the whitelisted/public script
hideLoadingScreen()    -- 3. Fade away the UI
